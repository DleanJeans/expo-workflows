# Copy this file to each Expo project as .github/workflows/pi.yml
# Step 1: Add OPENCODE_API_KEY as a repo secret
#   Settings → Secrets and variables → Actions → New repository secret
#   Name: OPENCODE_API_KEY   Value: <your key>

name: Pi Agent

on:
  issue_comment:
    types: [created]
  pull_request_review_comment:
    types: [created]

jobs:
  pi:
    uses: dleanjeans/expo-workflows/.github/workflows/pi.yml@main
    secrets:
      api-key: ${{ secrets.OPENCODE_API_KEY }}
